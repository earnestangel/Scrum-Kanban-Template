#!/bin/sh
# Board check for every provider: Claude Code, Codex, Gemini, opencode, or a human all commit through git.
# Installed by: git config core.hooksPath scripts/git-hooks
# Runs on every commit of a repository that has a board: a design file or an ADR outside docs/kanban/
# can break the board too (protocol 10). See scripts/kanban/precommit-check.mjs for what it checks.
root="$(git rev-parse --show-toplevel)"
[ -f "$root/docs/kanban/board.json" ] || exit 0
command -v node >/dev/null 2>&1 || { echo "pre-commit: node not found; skipping the board check" >&2; exit 0; }
exec node "$root/scripts/kanban/precommit-check.mjs"
